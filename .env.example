# One password for the whole team. Also the secret the Apps Script trigger sends.
APP_PASSWORD=

# Claude scoring
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Google Drive service account (paste the whole JSON key on one line)
GOOGLE_SERVICE_ACCOUNT_JSON=
# The "Sri Varuni Reel Review" folder id (from its Drive URL). Subfolders are created inside it.
DRIVE_ROOT_FOLDER_ID=

# Supabase (Project settings > API). Service role key stays server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Telugu/English transcription of the voiceover
GROQ_API_KEY=

# Optional, week two: Instagram insights
META_ACCESS_TOKEN=
IG_USER_ID=

# Tuning knobs (0-100 sharpness scale; calibrate on your own reels)
SHARPNESS_MIN=55
